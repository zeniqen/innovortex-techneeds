# The MongoDB database the platform reads and writes.
# A local MongoDB works:
#   MONGO_URI=mongodb://127.0.0.1:27017/techneeds
# An Atlas cluster works too:
#   MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/techneeds?retryWrites=true&w=majority
MONGO_URI=

# The key the session tokens are signed with. Any long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# The key the admin panel writes with. It is sent in the x-admin-key header
# and never reaches the browser, because the frontend's own API routes add
# it on the server side.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_KEY=

# The port the server listens on. The frontend expects 8000 by default.
PORT=8000
